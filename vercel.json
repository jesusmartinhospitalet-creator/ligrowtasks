{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["src/**", "public/**", "database/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/dashboard-v3.js", "dest": "/public/dashboard-v3.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
