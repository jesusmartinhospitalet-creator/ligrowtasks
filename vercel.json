{
  "version": 2,
  "builds": [
    {
      "src": "src/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "src/server.js" },
    { "src": "/(.+\\.(js|css|html|png|jpg|svg|ico|woff2?))", "dest": "/public/$1" },
    { "src": "/(.*)", "dest": "/public/preview.html" }
  ]
}
