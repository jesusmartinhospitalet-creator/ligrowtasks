{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "public/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/styles.css", "dest": "/public/styles.css" },
    { "src": "/dashboard-v3.js", "dest": "/public/dashboard-v3.js" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
